# MongoDB connection string (server-side only — never expose to the client)
# Example Atlas string:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net

# Database name
MONGODB_DB=ttd_auto

# Secret used to sign auth JWTs. Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Cookie name (can stay default)
AUTH_COOKIE_NAME=auth_token

# Base URL the SPA lives at, used for cookie settings
# For local dev against the dev server this stays empty/omitted.
# For production Vercel, set it to your site (e.g. https://yourdomain.com)
CLIENT_ORIGIN=

# Session lifetime in days
SESSION_DAYS=30
